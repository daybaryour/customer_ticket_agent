# Copy to .env and fill in the secrets before starting the app.

# Ollama endpoint.
# Docker Compose: Ollama runs on the host, so containers reach it through the
# Docker gateway configured via extra_hosts in docker-compose.yml.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Non-Docker (uvicorn / npm run dev running directly on the host):
# OLLAMA_BASE_URL=http://localhost:11434

OPENAI_API_KEY=

DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=llama3.1:8b
FALLBACK_PROVIDER=openai
FALLBACK_MODEL=gpt-4o-mini
FALLBACK_ENABLED=true
EMBED_MODEL=nomic-embed-text
CONFIDENCE_THRESHOLD=0.75
